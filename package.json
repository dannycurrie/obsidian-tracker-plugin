{
  "name": "weekly-scoreboard",
  "version": "0.1.0",
  "description": "2027 Scoreboard: weekly targets and year-on-pace view for Obsidian.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "esbuild .scratch/2027-scoreboard/preview/render-preview.tsx --bundle --platform=node --format=cjs --jsx=automatic --jsx-import-source=preact --log-level=warning --outfile=node_modules/.cache/scoreboard-preview.cjs && node node_modules/.cache/scoreboard-preview.cjs",
    "install:dev-vault": "npm run build && node scripts/install-dev-vault.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "preact": "^10.24.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.14.4",
    "preact-render-to-string": "^6.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
